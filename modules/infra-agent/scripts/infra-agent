#!/usr/bin/env bash

set -euo pipefail
export LC_ALL=C

# Generated by modules/infra-agent from dotfiles.infraAgent.
config=@config@
credd=@credd@
dnsmasq=@dnsmasq@
# Installed in the image by dotfiles.agentProfiles (modules/agent-profiles).
agent_profile_directory=/home/adamr/.config/agent-profiles
# The broker reaches infra-credd on this vsock port (systems/infra-broker).
credd_vsock_port=9100
# Runs in the agent VM before every attach. The incident token is read from a
# read-only mount so that revoking and reissuing it needs no new sandbox.
# shellcheck disable=SC2016
attach_script='if [ -n "${OPENCODE_CONFIG:-}" ] && [ ! -r "$OPENCODE_CONFIG" ]; then printf "%s\n" "infra-agent: this sandbox image has no agent profile ${AGENT_PROFILE:-} ($OPENCODE_CONFIG). Rebuild the image with make.sh image --force, then recreate the incident sandbox." >&2; exit 1; fi; if [ ! -r /run/infra-agent/mcp-token ]; then printf "%s\n" "infra-agent: the incident token is missing; run infra-agent resume on the host." >&2; exit 1; fi; INFRA_MCP_TOKEN="$(cat /run/infra-agent/mcp-token)"; export INFRA_MCP_TOKEN; cd /workspace && exec "$@"'
# Same Copilot secret as code-agent: the guest only ever sees the placeholder.
copilot_secret_env=CODE_AGENT_COPILOT_TOKEN
copilot_secret_host=api.githubcopilot.com
copilot_auth_path=/home/adamr/.local/share/opencode/auth.json
# shellcheck disable=SC2016
copilot_auth_json='{"github-copilot":{"type":"oauth","refresh":"$MSB_CODE_AGENT_COPILOT_TOKEN","access":"$MSB_CODE_AGENT_COPILOT_TOKEN","expires":0}}'

die() { printf 'infra-agent: %s\n' "$*" >&2; exit 1; }
warn() { printf 'infra-agent: %s\n' "$*" >&2; }
conf() { jq -r "$1" "$config"; }
env_conf() { jq -r --arg env "$environment" ".environments[\$env]$1" "$config"; }

command_help() {
  local command="${1:-}"
  case "$command" in
    '')
      printf '%s\n' \
        'Usage: infra-agent COMMAND [ARGS] [OPTIONS]' \
        '       infra-agent help [COMMAND]' \
        '' \
        'Production triage agents without credentials. Shell alias: ia.' \
        '' \
        'Incidents (one agent VM each, reaching only the LLM and its broker):' \
        '  start    Start or resume an incident and run opencode in it.' \
        '  resume   Resume an existing incident.' \
        '  stop     Stop an incident VM, keeping its workspace and session.' \
        '  status   Show incidents and brokers, or one incident.' \
        '  cleanup  Remove an incident VM, its token and (by default) its workspace.' \
        '' \
        'Brokers (one VM per environment, holding short-lived credentials):' \
        '  broker   up | down | status | doctor | logs' \
        '  creds    Show the credentials infra-credd has minted (no secret values).' \
        '  audit    Show the audit log of tool calls and credential mints.' \
        '  revoke   Stop the broker and credd, and invalidate every incident token.' \
        '' \
        'Configuration comes from dotfiles.infraAgent in Home Manager.' \
        'infra-agent --print-image / --print-broker-image print image tags for make.sh.'
      return
      ;;
    start|resume)
      printf 'Usage: infra-agent %s INCIDENT [--env ENV] [--skip-preflight] [-- COMMAND [ARG...]]\n\n' "$command"
      if [ "$command" = start ]; then
        printf '%s\n' 'Create the incident (bound to ENV, or the default environment) if needed, make sure' \
          "the environment's broker and infra-credd are running, then run opencode in /workspace."
      else
        printf '%s\n' 'Start the existing incident VM (and its broker if needed), then run opencode.'
      fi
      printf '%s\n' 'Pass a command after -- to run it instead. Exiting leaves the VM running.' \
        'Preflight checks (SSO sessions, VPNs, reachability) run when the broker is (re)started;' \
        '--skip-preflight skips them. INCIDENT names are normalized to lower snake case.'
      ;;
    stop) printf '%s\n' 'Usage: infra-agent stop INCIDENT' '' 'Stop the incident VM. Its workspace, session and token are kept.' ;;
    status) printf '%s\n' 'Usage: infra-agent status [INCIDENT]' '' 'Show one incident, or every incident and broker.' ;;
    cleanup)
      printf '%s\n' 'Usage: infra-agent cleanup INCIDENT [--keep-workspace] [--dry-run]' '' \
        'Remove the incident VM (including its opencode sessions), revoke its broker token, and delete' \
        'its workspace, which can contain customer data. --keep-workspace keeps the workspace directory.'
      ;;
    broker)
      printf '%s\n' 'Usage: infra-agent broker (up|down|status|doctor|logs) [--env ENV] [--skip-preflight]' '' \
        '  up      Start infra-credd and the broker VM (recreated when its configuration changed).' \
        '  down    Remove the broker VM and stop infra-credd. Incident tokens are kept.' \
        '  status  Show the broker, its health and minted credentials.' \
        '  doctor  Check credentials and reachability from inside the broker.' \
        '  logs    Show the broker log.'
      ;;
    creds) printf '%s\n' 'Usage: infra-agent creds [--env ENV]' '' 'Show the credentials infra-credd has cached, with expiry. Secret values are never shown.' ;;
    audit) printf '%s\n' 'Usage: infra-agent audit [INCIDENT] [--env ENV] [--follow]' '' 'Show audit records (tool calls, results metadata, credential mints) as JSON lines.' ;;
    revoke)
      printf '%s\n' 'Usage: infra-agent revoke [--env ENV]' '' \
        'Remove the broker VM, stop infra-credd (dropping every cached credential), and delete every incident' \
        "token for the environment. Incidents get new tokens on their next start or resume."
      ;;
    help) printf '%s\n' 'Usage: infra-agent help [COMMAND]' ;;
    *) printf 'Unknown command: %s\n' "$command" >&2; return 2 ;;
  esac
}

if [ "$#" -eq 0 ]; then command_help; exit 0; fi
case "$1" in
  help|--help|-h)
    command_help "${2:-}"
    exit $?
    ;;
  --print-image) conf .agent.image; exit 0 ;;
  --print-broker-image) conf .broker.image; exit 0 ;;
esac
action="$1"
shift
case "$action" in
  start|resume|stop|status|cleanup|broker|creds|audit|revoke) ;;
  *) printf 'Unknown command: %s\n' "$action" >&2; command_help >&2; exit 2 ;;
esac

# ---- arguments ---------------------------------------------------------------
environment_option=''
skip_preflight=false
keep_workspace=false
dry_run=false
follow=false
positional=()
attach_command=(opencode)
while [ "$#" -gt 0 ]; do
  case "$1" in
    --help|-h|help) command_help "$action"; exit 0 ;;
    --env) [ "$#" -ge 2 ] || { command_help "$action" >&2; exit 2; }; environment_option="$2"; shift 2 ;;
    --env=*) environment_option="${1#--env=}"; shift ;;
    --skip-preflight) skip_preflight=true; shift ;;
    --keep-workspace) [ "$action" = cleanup ] || { command_help "$action" >&2; exit 2; }; keep_workspace=true; shift ;;
    --dry-run) [ "$action" = cleanup ] || { command_help "$action" >&2; exit 2; }; dry_run=true; shift ;;
    --follow|-f) [ "$action" = audit ] || { command_help "$action" >&2; exit 2; }; follow=true; shift ;;
    --)
      [ "$action" = start ] || [ "$action" = resume ] || { command_help "$action" >&2; exit 2; }
      shift
      [ "$#" -gt 0 ] || { command_help "$action" >&2; exit 2; }
      attach_command=("$@")
      set --
      ;;
    -*) command_help "$action" >&2; exit 2 ;;
    *) positional+=("$1"); shift ;;
  esac
done

# ---- names and paths ------------------------------------------------------------
state_root="$(realpath -m "$(conf .stateDirectory)")"
private_root="$state_root/.infra-agent"
incidents_root="$state_root/incidents"
[[ "$state_root" != *:* && "$state_root" != *$'\n'* ]] || die 'state directory paths containing colons or newlines are unsupported'

normalize() {
  local id hash
  id="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/_/g; s/^_+//; s/_+$//')"
  [ -n "$id" ] || die 'incident names must contain at least one ASCII letter or number'
  if [ "${#id}" -gt 40 ]; then
    hash="$(printf '%s' "$id" | sha256sum)"
    id="${id:0:31}_${hash:0:8}"
  fi
  printf '%s\n' "$id"
}

select_environment() {
  environment="${1:-}"
  if [ -z "$environment" ]; then environment="$(conf '.defaultEnvironment // ""')"; fi
  [ -n "$environment" ] || die "choose an environment with --env ($(conf '.environments | keys | join(", ")'))"
  [ "$(jq -r --arg env "$environment" '.environments | has($env)' "$config")" = true ] ||
    die "unknown environment: $environment ($(conf '.environments | keys | join(", ")'))"
  port="$(env_conf .port)"
  broker="$(env_conf .brokerSandbox)"
  broker_dir="$private_root/brokers/$environment"
  run_dir="$broker_dir/run"
  tokens_dir="$run_dir/tokens"
  credd_sock="$broker_dir/credd.sock"
  audit_log="$private_root/audit/$environment.jsonl"
}

select_incident() {
  [ "${#positional[@]}" -eq 1 ] || { command_help "$action" >&2; exit 2; }
  incident="$(normalize "${positional[0]}")"
  sandbox="$(conf .sandboxPrefix)-$incident"
  [[ "$sandbox" =~ ^[a-zA-Z0-9][a-zA-Z0-9_-]*$ ]] || die 'invalid sandbox prefix'
  workspace="$incidents_root/$incident"
  incident_meta="$private_root/incidents/$incident.json"
  incident_run="$private_root/incidents/$incident.run"
  incident_lock="$private_root/incidents/$incident.lock"
}

private_dir() {
  local directory="$1"
  mkdir -p "$directory"
  chmod 700 "$directory"
  [ "$(realpath -m "$directory")" = "$directory" ] || die "refusing symlinked path: $directory"
}

new_token() { od -An -vtx1 -N32 /dev/urandom | tr -d ' \n'; }

write_private() {
  local path="$1" value="$2" tmp
  tmp="$(mktemp "$(dirname "$path")/.tmp.XXXXXXXX")"
  chmod 600 "$tmp"
  printf '%s\n' "$value" > "$tmp"
  mv -f "$tmp" "$path"
}

locks=()
release_locks() {
  local lock
  for lock in "${locks[@]}"; do rmdir -- "$lock" 2>/dev/null || true; done
}
trap release_locks EXIT
take_lock() {
  local lock="$1" attempts=0
  until mkdir "$lock" 2>/dev/null; do
    attempts=$((attempts + 1))
    [ "$attempts" -lt 30 ] || die "locked: $lock (remove it only after confirming no infra-agent command is running)"
    sleep 1
  done
  locks+=("$lock")
}
drop_lock() {
  local lock="$1" kept=() entry
  rmdir -- "$lock" 2>/dev/null || true
  for entry in "${locks[@]}"; do [ "$entry" = "$lock" ] || kept+=("$entry"); done
  locks=("${kept[@]}")
}

# ---- microsandbox ----------------------------------------------------------------
require_msb() { command -v msb >/dev/null 2>&1 || die 'microsandbox CLI (msb) is not on PATH'; }
sandbox_exists() {
  local names name
  names="$(msb ls -q)" || die 'cannot list microsandboxes'
  while IFS= read -r name; do [ "$name" != "$1" ] || return 0; done <<< "$names"
  return 1
}
sandbox_status() {
  local inspection
  inspection="$(msb inspect "$1" --format json)" || die "cannot inspect sandbox $1"
  jq -er '.status | select(type == "string")' <<< "$inspection" || die "invalid status for sandbox $1"
}

# ---- Copilot (shared with code-agent) ----------------------------------------------
copilot_token=''
load_copilot_token() {
  local file mode
  file="$(conf .copilotTokenFile)"
  [ -f "$file" ] || die "Copilot token file is missing: $file (run code-agent login)"
  mode="$(stat -L -c %a -- "$file")" || die "cannot inspect Copilot token file: $file"
  (( (8#$mode & 8#077) == 0 )) || die "Copilot token file must not be accessible by group or others: $file (chmod 600)"
  [[ "$(realpath -m "$file")/" != "$state_root/"* ]] || die 'Copilot token file must not be inside the infra-agent state directory'
  IFS= read -r copilot_token < "$file" || true
  [[ "$copilot_token" =~ ^[A-Za-z0-9_.-]+$ ]] || die "Copilot token file must contain a single token: $file (run code-agent login)"
}

# ---- infra-credd and DNS ------------------------------------------------------------
credd_running() {
  [ -S "$credd_sock" ] && curl --unix-socket "$credd_sock" -fsS --max-time 2 http://credd/healthz >/dev/null 2>&1
}
pid_alive() {
  local pid_file="$1" name="$2" pid
  [ -f "$pid_file" ] || return 1
  pid="$(< "$pid_file")"
  [[ "$pid" =~ ^[0-9]+$ ]] || return 1
  kill -0 "$pid" 2>/dev/null || return 1
  # Guard against a recycled PID before signalling it.
  if [ -r "/proc/$pid/cmdline" ]; then
    tr '\0' ' ' < "/proc/$pid/cmdline" | grep -q -- "$name"
  else
    ps -p "$pid" -o args= 2>/dev/null | grep -q -- "$name"
  fi
}
stop_daemon() {
  local pid_file="$1" name="$2"
  if pid_alive "$pid_file" "$name"; then kill "$(< "$pid_file")" 2>/dev/null || true; fi
  rm -f -- "$pid_file"
}
start_credd() {
  if credd_running; then return; fi
  stop_daemon "$broker_dir/credd.pid" infra-credd
  rm -f -- "$credd_sock"
  [ "${#credd_sock}" -lt 100 ] || die "socket path is too long for Unix sockets: $credd_sock (shorten stateDirectory)"
  nohup "$credd" serve --config "$(env_conf .creddConfig)" --socket "$credd_sock" \
    --token-file "$run_dir/credd-token" --audit-log "$audit_log" >> "$broker_dir/credd.log" 2>&1 < /dev/null &
  printf '%s\n' "$!" > "$broker_dir/credd.pid"
  local attempts=0
  until credd_running; do
    attempts=$((attempts + 1))
    [ "$attempts" -lt 50 ] || die "infra-credd did not start; see $broker_dir/credd.log"
    sleep 0.2
  done
}
start_dns() {
  local dns_port domain server arguments=()
  dns_port="$(env_conf '.dnsPort // ""')"
  [ -n "$dns_port" ] || return 0
  if pid_alive "$broker_dir/dnsmasq.pid" dnsmasq; then return; fi
  while IFS=$'\t' read -r domain server; do
    arguments+=("--server=/$domain/$server")
  done < <(env_conf '.dnsForwarders | to_entries[] | [.key, .value] | @tsv')
  "$dnsmasq" --pid-file="$broker_dir/dnsmasq.pid" --listen-address=127.0.0.1 --port="$dns_port" \
    --bind-interfaces --no-hosts --log-facility="$broker_dir/dnsmasq.log" "${arguments[@]}" ||
    die "dnsmasq did not start; see $broker_dir/dnsmasq.log"
}
credd_get() {
  credd_running || die "infra-credd is not running for $environment (infra-agent broker up --env $environment)"
  curl --unix-socket "$credd_sock" -fsS --max-time 30 -H "Authorization: Bearer $(< "$run_dir/credd-token")" "http://credd$1"
}

# ---- preflight -----------------------------------------------------------------------
interactive() { [ -t 0 ] && [ -t 2 ]; }
# shellcheck disable=SC2016
tcp_reachable() { timeout 3 bash -c 'exec 3<>"/dev/tcp/$1/$2"' _ "$1" "$2" 2>/dev/null; }
preflight() {
  local profile tenant vpn check name host target_port via failed=false
  local profiles=()
  printf 'Preflight for %s:\n' "$environment" >&2
  # Read lists up front: logins below need the terminal on stdin.
  mapfile -t profiles < <(env_conf '.preflight.awsProfiles[]')
  for profile in "${profiles[@]}"; do
    [ -n "$profile" ] || continue
    command -v aws >/dev/null 2>&1 || die 'the aws CLI is not on PATH (infra-credd mints AWS credentials with it)'
    if aws sts get-caller-identity --profile "$profile" --output text >/dev/null 2>&1; then
      printf '  ok    aws profile %s\n' "$profile" >&2
    elif interactive; then
      printf '  login aws profile %s (session expired)\n' "$profile" >&2
      aws sso login --profile "$profile" >&2 || die "aws sso login --profile $profile failed"
    else
      die "AWS session for profile $profile has expired: run aws sso login --profile $profile"
    fi
  done
  tenant="$(env_conf '.preflight.azureTenant // ""')"
  if [ -n "$tenant" ]; then
    command -v az >/dev/null 2>&1 || die 'the az CLI is not on PATH (infra-credd mints Azure tokens with it)'
    if az account get-access-token --tenant "$tenant" --resource https://management.azure.com/ --output none >/dev/null 2>&1; then
      printf '  ok    azure tenant %s\n' "$tenant" >&2
    elif interactive; then
      printf '  login azure tenant %s\n' "$tenant" >&2
      az login --tenant "$tenant" --output none >&2 || die "az login --tenant $tenant failed"
    else
      die "Azure session for tenant $tenant has expired: run az login --tenant $tenant"
    fi
  fi
  while IFS=$'\t' read -r vpn check; do
    [ -n "$vpn" ] || continue
    if [ -z "$check" ]; then continue; fi
    if sh -c "$check" >/dev/null 2>&1; then printf '  ok    vpn %s\n' "$vpn" >&2
    else printf '  DOWN  vpn %s\n' "$vpn" >&2; failed=true; fi
  done < <(env_conf '.preflight.vpns | to_entries[] | [.key, (.value // "")] | @tsv')
  while IFS=$'\t' read -r name host target_port via; do
    [ -n "$name" ] || continue
    if tcp_reachable "$host" "$target_port"; then printf '  ok    %s (%s:%s)\n' "$name" "$host" "$target_port" >&2
    else printf '  DOWN  %s (%s:%s)%s\n' "$name" "$host" "$target_port" "${via:+ via $via}" >&2; failed=true; fi
  done < <(env_conf '.preflight.targets[] | [.name, .host, (.port | tostring), (.via // "")] | @tsv')
  if [ "$failed" = true ]; then
    warn 'some private targets are unreachable from this host; their tools will fail until the VPN is up'
  fi
}

# ---- broker ---------------------------------------------------------------------------
broker_healthy() { curl -fsS --max-time 3 "http://127.0.0.1:$port/healthz" >/dev/null 2>&1; }
broker_hash() {
  printf '%s|%s|%s|%s|%s\n' "$(env_conf .configHash)" "$(conf .broker.image)" "$(conf .broker.cpus)" \
    "$(conf .broker.memory)" "$(conf .broker.rootDisk)" | sha256sum | cut -d ' ' -f 1
}
prepare_broker_dirs() {
  private_dir "$private_root"
  private_dir "$private_root/brokers"
  private_dir "$private_root/audit"
  private_dir "$broker_dir"
  private_dir "$run_dir"
  private_dir "$tokens_dir"
  if [ ! -s "$run_dir/credd-token" ]; then write_private "$run_dir/credd-token" "$(new_token)"; fi
}
lock_broker() {
  prepare_broker_dirs
  take_lock "$broker_dir/lock"
}
broker_up() {
  local want status secrets_json rules count index name command value hosts secret_names=() secret_values=()
  local options=() host ca dns_port
  lock_broker
  want="$(broker_hash)"
  status=''
  if sandbox_exists "$broker"; then status="$(sandbox_status "$broker")"; fi
  if [ "$status" = Running ] && [ "$(cat "$broker_dir/broker.hash" 2>/dev/null || true)" = "$want" ] &&
    credd_running && broker_healthy; then
    drop_lock "$broker_dir/lock"
    return
  fi
  if [ "$skip_preflight" = false ]; then preflight; fi
  start_credd
  start_dns
  if [ -n "$status" ]; then
    printf 'Recreating broker %s.\n' "$broker" >&2
    msb rm --force "$broker"
  else
    printf 'Starting broker %s.\n' "$broker" >&2
  fi
  rules="$(env_conf '.netRules | join(",")')"
  [ -n "$rules" ] || warn "environment $environment declares no services; its broker can reach nothing"
  options+=(--net-default-egress deny)
  if [ -n "$rules" ]; then options+=(--net-rule "$rules"); fi
  # Hostname rules only work on HTTPS that microsandbox can inspect.
  options+=(--tls-intercept)
  while IFS= read -r host; do [ -z "$host" ] || options+=(--tls-bypass "$host"); done < <(env_conf '.tlsBypass[]')
  while IFS= read -r ca; do [ -z "$ca" ] || options+=(--tls-upstream-ca-cert "$ca"); done < <(env_conf '.tlsUpstreamCaCerts[]')
  dns_port="$(env_conf '.dnsPort // ""')"
  if [ -n "$dns_port" ]; then options+=(--dns-nameserver "127.0.0.1:$dns_port"); fi
  secrets_json="$(env_conf '.secrets')"
  count="$(jq length <<< "$secrets_json")"
  for ((index = 0; index < count; index++)); do
    name="$(jq -r --argjson i "$index" '.[$i].name' <<< "$secrets_json")"
    command="$(jq -r --argjson i "$index" '.[$i].command' <<< "$secrets_json")"
    hosts="$(jq -r --argjson i "$index" '.[$i].hosts | join(",")' <<< "$secrets_json")"
    value="$(sh -c "$command")" || die "secret command for $name failed"
    [ -n "$value" ] && [[ "$value" != *$'\n'* ]] || die "secret command for $name must print exactly one line"
    secret_names+=("$name")
    secret_values+=("$value")
    options+=(--secret "$name@$hosts")
  done
  (
    # Secret values reach msb only through its environment, never its arguments.
    for ((index = 0; index < ${#secret_names[@]}; index++)); do export "${secret_names[$index]}=${secret_values[$index]}"; done
    exec msb run -d --name "$broker" --cpus "$(conf .broker.cpus)" --memory "$(conf .broker.memory)" \
      --root-disk "$(conf .broker.rootDisk)" \
      "${options[@]}" \
      -p "127.0.0.1:$port:8080" \
      --vsock "$credd_sock:$credd_vsock_port" \
      --volume "$(env_conf .brokerConfig):/etc/infra-broker:ro" \
      --volume "$run_dir:/run/infra:ro,uid=1000,gid=1000" \
      "$(conf .broker.image)" > /dev/null
  )
  printf '%s\n' "$want" > "$broker_dir/broker.hash"
  local attempts=0
  until broker_healthy; do
    attempts=$((attempts + 1))
    if [ "$attempts" -ge 90 ]; then
      msb logs "$broker" --tail 40 >&2 || true
      die "broker $broker did not become healthy on 127.0.0.1:$port"
    fi
    sleep 1
  done
  printf 'Broker %s is up on 127.0.0.1:%s (%s).\n' "$broker" "$port" "$(env_conf '.servers | join(", ")')" >&2
  drop_lock "$broker_dir/lock"
}
broker_down() {
  if sandbox_exists "$broker"; then msb rm --force "$broker"; fi
  stop_daemon "$broker_dir/credd.pid" infra-credd
  rm -f -- "$credd_sock" "$broker_dir/broker.hash"
  stop_daemon "$broker_dir/dnsmasq.pid" dnsmasq
}
audit_host() {
  [ -d "$private_root/audit" ] || return 0
  jq -cn --arg env "$environment" --arg event "$1" --arg detail "${2:-}" \
    '{ts: (now | todate), environment: $env, source: "infra-agent", event: $event, detail: $detail}' >> "$audit_log"
}

# ---- incidents ---------------------------------------------------------------------------
ensure_incident_token() {
  local token=''
  private_dir "$private_root/incidents"
  private_dir "$incident_run"
  if [ -s "$tokens_dir/$incident" ] && [ -s "$incident_run/mcp-token" ] &&
    [ "$(< "$tokens_dir/$incident")" = "$(< "$incident_run/mcp-token")" ]; then
    return
  fi
  token="$(new_token)"
  write_private "$tokens_dir/$incident" "$token"
  write_private "$incident_run/mcp-token" "$token"
  audit_host token "$incident"
}
agent_create() {
  local options=() rules llm opencode_config copilot=false
  rules=()
  while IFS= read -r llm; do [ -z "$llm" ] || rules+=("allow@$llm:tcp:443"); done < <(conf '.llmHosts[]')
  # The broker is the agent's only other destination.
  rules+=("allow@host.microsandbox.internal:tcp:$port" "allow@host:tcp:$port")
  options+=(--net-default-egress deny --net-rule "$(IFS=,; printf '%s' "${rules[*]}")" --tls-intercept)
  if [ -n "$(conf .copilotTokenFile)" ]; then
    load_copilot_token
    copilot=true
    options+=(--secret "$copilot_secret_env@$copilot_secret_host")
  else
    warn 'dotfiles.infraAgent.copilotTokenFile is not set; opencode has no model credentials in the VM'
  fi
  opencode_config="$(jq -c .agent.opencodeConfig "$config")"
  jq -n --arg env "$environment" --arg sandbox "$sandbox" --argjson copilot "$copilot" \
    '{environment: $env, sandbox: $sandbox, copilotSecret: $copilot, created: (now | todate)}' > "$incident_meta"
  CODE_AGENT_COPILOT_TOKEN="$copilot_token" msb create --name "$sandbox" --cpus "$(conf .agent.cpus)" \
    --memory "$(conf .agent.memory)" --root-disk "$(conf .agent.rootDisk)" \
    "${options[@]}" \
    --volume "$workspace:/workspace" \
    --volume "$incident_run:/run/infra-agent:ro,uid=1000,gid=1000" \
    --env "OPENCODE_CONFIG=$agent_profile_directory/$(conf .agent.profile)/opencode.json" \
    --env "AGENT_PROFILE=$(conf .agent.profile)" \
    --env "OPENCODE_CONFIG_CONTENT=$opencode_config" \
    --env "INFRA_MCP_URL=http://host.microsandbox.internal:$port/mcp" \
    --env "INFRA_ENVIRONMENT=$environment" \
    --env "INFRA_INCIDENT=$incident" \
    --env OPENCODE_DISABLE_MODELS_FETCH=1 \
    --env OPENCODE_DISABLE_LSP_DOWNLOAD=1 \
    "$(conf .agent.image)"
}
agent_up() {
  local copilot
  if sandbox_exists "$sandbox"; then
    copilot="$(jq -r '.copilotSecret // false' "$incident_meta")"
    case "$(sandbox_status "$sandbox")" in
      Running) ;;
      Paused) msb resume "$sandbox" ;;
      Created|Stopped|Crashed)
        # msb re-reads secret values from its environment on every start.
        if [ "$copilot" = true ]; then
          load_copilot_token
          CODE_AGENT_COPILOT_TOKEN="$copilot_token" msb start "$sandbox"
        else
          msb start "$sandbox"
        fi
        ;;
      *) die 'incident sandbox is transitioning or has an unknown status; retry later' ;;
    esac
  elif [ "$action" = resume ]; then
    die "incident sandbox $sandbox is absent; use infra-agent start to recreate it"
  else
    agent_create
  fi
  [ "$(sandbox_status "$sandbox")" = Running ] || die 'incident sandbox did not start; retry later'
  if [ "$(jq -r '.copilotSecret // false' "$incident_meta")" = true ]; then
    # shellcheck disable=SC2016
    msb exec "$sandbox" -- bash -c 'set -e; mkdir -p "${1%/*}"; umask 077; if [ ! -e "$1" ]; then printf "%s\n" "$2" > "$1"; fi' \
      infra-agent "$copilot_auth_path" "$copilot_auth_json" || die 'cannot configure the opencode Copilot placeholder in the sandbox'
  fi
}

print_incident() {
  printf 'Incident: %s\nEnvironment: %s\nSandbox: %s\nBroker: %s (127.0.0.1:%s)\nWorkspace: %s\n' \
    "$incident" "$environment" "$sandbox" "$broker" "$port" "$workspace"
}

# ---- commands --------------------------------------------------------------------------------
case "$action" in
  start|resume)
    require_msb
    select_incident
    private_dir "$state_root"
    private_dir "$private_root"
    private_dir "$private_root/incidents"
    take_lock "$incident_lock"
    if [ -f "$incident_meta" ]; then
      recorded="$(jq -r .environment "$incident_meta")"
      [ -z "$environment_option" ] || [ "$environment_option" = "$recorded" ] ||
        die "incident $incident belongs to environment $recorded"
      select_environment "$recorded"
    elif [ "$action" = resume ]; then
      die "incident $incident does not exist; use infra-agent start"
    else
      select_environment "$environment_option"
    fi
    broker_up
    ensure_incident_token
    private_dir "$incidents_root"
    private_dir "$workspace"
    agent_up
    print_incident
    printf '%s\n' "Write findings to /workspace (report.md). Exiting leaves the VM running; infra-agent cleanup removes it."
    drop_lock "$incident_lock"
    msb exec --tty "$sandbox" -- zsh -c "$attach_script" infra-agent "${attach_command[@]}"
    ;;
  stop)
    require_msb
    select_incident
    [ -f "$incident_meta" ] || die "incident $incident does not exist"
    take_lock "$incident_lock"
    if sandbox_exists "$sandbox"; then
      case "$(sandbox_status "$sandbox")" in
        Paused) msb resume "$sandbox"; msb stop "$sandbox" ;;
        Running) msb stop "$sandbox" ;;
        *) ;;
      esac
    fi
    ;;
  status)
    require_msb
    if [ "${#positional[@]}" -gt 0 ]; then
      select_incident
      [ -f "$incident_meta" ] || die "incident $incident does not exist"
      select_environment "$(jq -r .environment "$incident_meta")"
      print_incident
      if sandbox_exists "$sandbox"; then printf 'Status: %s\n' "$(sandbox_status "$sandbox")"; else printf 'Status: absent\n'; fi
    else
      printf 'Incidents:\n'
      for meta in "$private_root"/incidents/*.json; do
        [ -f "$meta" ] || continue
        printf '  %s (%s)\n' "$(basename "$meta" .json)" "$(jq -r .environment "$meta")"
      done
      printf 'Brokers:\n'
      while IFS= read -r name; do
        select_environment "$name"
        if broker_healthy; then health=healthy; else health=down; fi
        printf '  %s: %s on 127.0.0.1:%s\n' "$environment" "$health" "$port"
      done < <(conf '.environments | keys[]')
      printf '\n'
      msb ls
    fi
    ;;
  cleanup)
    require_msb
    select_incident
    [ -f "$incident_meta" ] || [ -d "$workspace" ] || die "incident $incident does not exist"
    if [ -f "$incident_meta" ]; then select_environment "$(jq -r .environment "$incident_meta")"; fi
    if [ "$dry_run" = true ]; then
      printf 'Would remove sandbox %s and the incident token' "$sandbox"
      if [ "$keep_workspace" = true ]; then printf ', keeping %s.\n' "$workspace"; else printf ', and delete %s.\n' "$workspace"; fi
      exit 0
    fi
    take_lock "$incident_lock"
    if sandbox_exists "$sandbox"; then msb rm --force "$sandbox"; fi
    if [ -n "${tokens_dir:-}" ]; then rm -f -- "$tokens_dir/$incident"; fi
    rm -rf -- "$incident_run"
    if [ "$keep_workspace" = false ]; then rm -rf -- "$workspace"; fi
    rm -f -- "$incident_meta"
    if [ -n "${environment:-}" ]; then audit_host cleanup "$incident"; fi
    printf 'Removed incident %s%s.\n' "$incident" "$([ "$keep_workspace" = true ] && printf ' (workspace kept at %s)' "$workspace")"
    ;;
  broker)
    require_msb
    [ "${#positional[@]}" -eq 1 ] || { command_help broker >&2; exit 2; }
    select_environment "$environment_option"
    case "${positional[0]}" in
      up) broker_up ;;
      down)
        lock_broker
        broker_down
        audit_host broker-down
        printf 'Broker %s removed and infra-credd stopped.\n' "$broker"
        ;;
      status)
        if sandbox_exists "$broker"; then printf 'Broker: %s (%s)\n' "$broker" "$(sandbox_status "$broker")"; else printf 'Broker: %s (absent)\n' "$broker"; fi
        if broker_healthy; then printf 'Gateway: healthy on 127.0.0.1:%s\n' "$port"; else printf 'Gateway: down\n'; fi
        if credd_running; then printf 'infra-credd: running\n'; credd_get /status | jq -r '.credentials[] | "  \(.kind) \(.key): \(.principal), expires \(.expires)"'
        else printf 'infra-credd: stopped\n'; fi
        ;;
      doctor)
        broker_up
        msb exec "$broker" -- infra-broker-credential doctor
        ;;
      logs) msb logs "$broker" --tail 200 ;;
      *) command_help broker >&2; exit 2 ;;
    esac
    ;;
  creds)
    [ "${#positional[@]}" -eq 0 ] || { command_help creds >&2; exit 2; }
    select_environment "$environment_option"
    credd_get /status | jq .
    ;;
  audit)
    [ "${#positional[@]}" -le 1 ] || { command_help audit >&2; exit 2; }
    filter=''
    if [ "${#positional[@]}" -eq 1 ]; then
      select_incident
      filter="$incident"
      if [ -z "$environment_option" ] && [ -f "$incident_meta" ]; then environment_option="$(jq -r .environment "$incident_meta")"; fi
    fi
    select_environment "$environment_option"
    [ -f "$audit_log" ] || die "no audit log yet for $environment ($audit_log)"
    # shellcheck disable=SC2016
    query='select($incident == "" or .incident == $incident or .key == $incident or .detail == $incident)'
    if [ "$follow" = true ]; then
      tail -n 50 -F "$audit_log" | jq --unbuffered -c --arg incident "$filter" "$query"
    else
      jq -c --arg incident "$filter" "$query" "$audit_log"
    fi
    ;;
  revoke)
    require_msb
    [ "${#positional[@]}" -eq 0 ] || { command_help revoke >&2; exit 2; }
    select_environment "$environment_option"
    lock_broker
    broker_down
    rm -f -- "$run_dir/credd-token"
    if [ -d "$tokens_dir" ]; then find "$tokens_dir" -mindepth 1 -maxdepth 1 -type f -delete; fi
    for meta in "$private_root"/incidents/*.json; do
      [ -f "$meta" ] || continue
      if [ "$(jq -r .environment "$meta")" = "$environment" ]; then rm -f -- "${meta%.json}.run/mcp-token"; fi
    done
    audit_host revoke
    printf 'Revoked %s: broker removed, cached credentials dropped, incident tokens deleted.\n' "$environment"
    printf '%s\n' 'Running agents lose broker access now; infra-agent resume issues a new token.'
    ;;
esac
