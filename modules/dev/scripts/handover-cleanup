#!/usr/bin/env bash

set -euo pipefail

usage() {
  printf 'usage: %s TASK-NAME\n' "$0" >&2
  exit 2
}

normalize_task() {
  local normalized
  normalized="$(printf '%s' "$1" \
    | tr '[:upper:]' '[:lower:]' \
    | sed -E 's/[^a-z0-9]+/_/g; s/^_+//; s/_+$//; s/_+/_/g')"
  [ -n "$normalized" ] || {
    echo "task name must contain at least one letter or number" >&2
    exit 2
  }
  printf '%s\n' "$normalized"
}

[ "$#" -eq 1 ] || usage
command -v msb >/dev/null 2>&1 || {
  echo "microsandbox CLI (msb) is not installed or is not on PATH" >&2
  exit 1
}

task_id="$(normalize_task "$1")"
repo_root="$(git rev-parse --show-toplevel)"
repo_name="$(basename "$repo_root")"
workspace_root="${HANDOVER_WORKSPACES_DIR:-$HOME/development/agent/workspaces}"
task_workspace="$workspace_root/$task_id"
workspace_repo="$task_workspace/$repo_name"
sandbox_name="${HANDOVER_SANDBOX_PREFIX:-dotfiles-agent}-$task_id"

case "$workspace_repo" in
  "$workspace_root"/*/*) ;;
  *)
    echo "refusing to clean an unsafe workspace path: $workspace_repo" >&2
    exit 1
    ;;
esac

 sandbox_found=false
while IFS= read -r name; do
  if [ "$name" = "$sandbox_name" ]; then
    sandbox_found=true
    break
  fi
done < <(msb ls -q)

if [ "$sandbox_found" = true ]; then
  msb rm --force "$sandbox_name"
else
  echo "Microsandbox not found: $sandbox_name" >&2
fi

if [ -e "$workspace_repo" ]; then
  rm -rf -- "$workspace_repo"
  echo "Removed workspace repository: $workspace_repo"
else
  echo "Workspace repository not found: $workspace_repo" >&2
fi

rmdir --ignore-fail-on-non-empty "$task_workspace" 2>/dev/null || true
