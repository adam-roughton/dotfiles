#!/usr/bin/env bash

set -euo pipefail

usage() {
  printf 'usage: %s TASK-NAME\n' "$0" >&2
  exit 2
}

normalize_task() {
  local normalized
  normalized="$(printf '%s' "$1" \
    | tr '[:upper:]' '[:lower:]' \
    | sed -E 's/[^a-z0-9]+/_/g; s/^_+//; s/_+$//; s/_+/_/g')"
  [ -n "$normalized" ] || {
    echo "task name must contain at least one letter or number" >&2
    exit 2
  }
  printf '%s\n' "$normalized"
}

find_working_repo() {
  local candidate root
  for candidate in "$task_workspace" "$task_workspace"/*; do
    [ -d "$candidate" ] || continue
    root="$(git -C "$candidate" rev-parse --show-toplevel 2>/dev/null || true)"
    if [ -n "$root" ]; then
      printf '%s\n' "$root"
      return 0
    fi
  done
  return 1
}

[ "$#" -eq 1 ] || usage

task_id="$(normalize_task "$1")"
repo_root="$(git rev-parse --show-toplevel)"
repo_name="$(basename "$repo_root")"
workspace_root="${HANDOVER_WORKSPACES_DIR:-$HOME/development/agent/workspaces}"
task_workspace="$workspace_root/$task_id"

if ! working_repo="$(find_working_repo)"; then
  echo "could not find a Git repository in: $task_workspace" >&2
  exit 1
fi

working_repo_name="$(basename "$working_repo")"
[ "$working_repo_name" = "$repo_name" ] || {
  echo "found $working_repo, expected a repository named $repo_name" >&2
  exit 1
}

bundle="$(mktemp "${TMPDIR:-/tmp}/handover-${task_id}.XXXXXX.bundle")"
cleanup() {
  rm -f "$bundle"
}
trap cleanup EXIT

git -C "$working_repo" bundle create "$bundle" HEAD
git -C "$working_repo" bundle verify "$bundle" >/dev/null
git -C "$repo_root" fetch "$bundle" "HEAD:refs/heads/$task_id"

printf 'Fetched %s into branch %s\n' "$working_repo" "$task_id"
