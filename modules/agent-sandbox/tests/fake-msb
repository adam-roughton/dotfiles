#!/usr/bin/env bash
set -euo pipefail

: "${FAKE_MSB_STATE:?}" "${FAKE_MSB_LOG:?}"
printf '%q ' "$@" >> "$FAKE_MSB_LOG"
printf '\n' >> "$FAKE_MSB_LOG"
# Record which commands received the secret through their environment.
if [ -n "${CODE_AGENT_COPILOT_TOKEN:-}" ]; then
  printf '%s %s\n' "$1" "$CODE_AGENT_COPILOT_TOKEN" >> "$FAKE_MSB_LOG.env"
fi
command="${1:?}"
shift
if [ "${FAKE_MSB_FAIL:-}" = "$command" ]; then
  printf 'injected msb %s failure\n' "$command" >&2
  exit 42
fi

# Sandbox images live beside, not inside, the state directory so that `ls`
# and status reads see only sandbox names and statuses.
images="$FAKE_MSB_STATE.images"

case "$command" in
  images)
    [ "$#" = 1 ] && [ "$1" = -q ] || exit 2
    printf '%s\n' "${FAKE_MSB_IMAGE:-dotfiles-agent:latest}"
    ;;
  rmi)
    [ "$#" = 2 ] && [ "$1" = --force ] || exit 2
    ;;
  load)
    [ "$#" = 4 ] && [ "$1" = --input ] && [ "$3" = --tag ] || exit 2
    [ -s "$2" ] || exit 3
    ;;
  ls)
    if [ "$#" = 2 ] && [ "$1" = --format ] && [ "$2" = json ]; then
      for entry in "$FAKE_MSB_STATE"/*; do
        [ -f "$entry" ] || continue
        name="${entry##*/}"
        # Tests may create sandboxes directly; msb reports unknown images as "-".
        image=-
        if [ -f "$images/$name" ]; then image="$(< "$images/$name")"; fi
        jq -n --arg name "$name" --arg status "$(< "$entry")" --arg image "$image" \
          '{name: $name, status: $status, image: $image}'
      done | jq -s .
      exit 0
    fi
    [ "$#" = 0 ] || [ "$*" = -q ] || exit 2
    for entry in "$FAKE_MSB_STATE"/*; do
      [ -f "$entry" ] || continue
      printf '%s\n' "${entry##*/}"
    done
    ;;
  create)
    [ "${1:-}" = --name ] || exit 2
    name="$2"
    [ ! -e "$FAKE_MSB_STATE/$name" ] || exit 3
    mkdir -p "$images"
    printf '%s\n' "${!#}" > "$images/$name"
    printf 'Running\n' > "$FAKE_MSB_STATE/$name"
    ;;
  inspect)
    [ "$#" = 3 ] && [ "$2" = --format ] && [ "$3" = json ] || exit 2
    if [ "${FAKE_MSB_FAIL_INSPECT_NAME:-}" = "$1" ]; then
      printf 'injected msb inspect failure for %s\n' "$1" >&2
      exit 42
    fi
    [ -f "$FAKE_MSB_STATE/$1" ] || exit 3
    printf '{"name":"%s","status":"%s"}\n' "$1" "$(< "$FAKE_MSB_STATE/$1")"
    ;;
  start|resume|restart|stop)
    [ "$#" = 1 ] && [ -f "$FAKE_MSB_STATE/$1" ] || exit 3
    status="$(< "$FAKE_MSB_STATE/$1")"
    case "$command:$status" in
      start:Created|start:Stopped|start:Crashed|resume:Paused|restart:Running|restart:Paused|restart:Created|restart:Stopped|restart:Crashed)
        [ "${FAKE_MSB_NO_TRANSITION:-}" = "$command" ] || printf 'Running\n' > "$FAKE_MSB_STATE/$1" ;;
      stop:Running|stop:Stopped|stop:Created|stop:Crashed)
        [ "${FAKE_MSB_NO_TRANSITION:-}" = "$command" ] || printf 'Stopped\n' > "$FAKE_MSB_STATE/$1" ;;
      *) printf 'invalid msb transition: %s from %s\n' "$command" "$status" >&2; exit 3 ;;
    esac
    ;;
  rm)
    [ "${1:-}" = --force ] && [ "$#" = 2 ] || exit 2
    [ -f "$FAKE_MSB_STATE/$2" ] || exit 3
    [ "$(< "$FAKE_MSB_STATE/$2")" = Stopped ] || exit 3
    rm -- "$FAKE_MSB_STATE/$2"
    rm -f -- "$images/$2"
    ;;
  exec)
    if [ "${1:-}" = --tty ]; then shift; fi
    [ -f "$FAKE_MSB_STATE/${1:-}" ] || exit 3
    [ "$(< "$FAKE_MSB_STATE/$1")" = Running ] || exit 3
    if [ -n "${FAKE_MSB_EXEC_LOCK:-}" ]; then
      [ ! -e "$FAKE_MSB_EXEC_LOCK" ] || { printf 'task lock held during exec\n' >&2; exit 4; }
    fi
    if [ -n "${FAKE_MSB_EXEC_SCRIPT:-}" ]; then
      bash "$FAKE_MSB_EXEC_SCRIPT" status "${FAKE_MSB_EXEC_TASK:?}"
    fi
    # Deliberately do not execute the guest command.
    ;;
  *) printf 'unsupported fake msb command: %s\n' "$command" >&2; exit 2 ;;
esac
