#!/usr/bin/env bash

set -euo pipefail
export LC_ALL=C

workspace_directory=@workspaceDirectory@
upstream_directory=@upstreamDirectory@
sandbox_prefix=@sandboxPrefix@
image=@image@
cpus=@cpus@
memory=@memory@
cache_directory=@cacheDirectory@

die() { printf '%s\n' "$*" >&2; exit 1; }
command_help() {
  local command="${1:-}" description
  if [ -z "$command" ]; then
    printf '%s\n' \
      'Usage: code-agent COMMAND [TASK] [OPTIONS]' \
      '       code-agent help [COMMAND]' \
      '' \
      'Isolated coding-agent workspaces. Shell alias: ca.' \
      '' \
      'Commands:' \
      '  setup    Prepare the host branch, upstream snapshot, and agent clone.' \
      '  start    Set up or resume a sandbox and attach a shell.' \
      '  resume   Attach to an existing sandbox without creating one.' \
      '  stop     Stop a sandbox while retaining its workspace and state.' \
      '  status   Show task paths and list sandboxes.' \
      '  sync     Fast-forward the host task branch from committed agent work.' \
      '  cleanup  Remove a sandbox and workspace with preservation checks.' \
      '  help     Show general or command-specific help.' \
      '' \
      'TASK defaults to the current host branch. Explicit names are normalized.' \
      'On main, setup/start prompt for a task branch.' \
      'Run code-agent help COMMAND or code-agent COMMAND --help for details.' \
      'Configuration comes from dotfiles.agentSandbox in Home Manager.' \
      'code-agent --print-image prints the configured image tag for build tooling.'
    return
  fi
  case "$command" in
    setup) description='Create or select the task branch, publish its committed snapshot, and prepare the agent clone. Does not create a sandbox.' ;;
    start) description='Perform setup, create or resume the sandbox, and enter /workspace. Launch the coding agent manually. Exiting the shell leaves the sandbox running.' ;;
    resume) description='Start or unpause an existing sandbox and enter /workspace. Does not create a missing sandbox or switch the host branch.' ;;
    stop) description='Stop the sandbox, retaining the workspace and sandbox state. A missing sandbox is harmless; the task must have setup metadata.' ;;
    status) description='Print the task branch, sandbox name, workspace, and upstream paths, then list microsandboxes. The task must have setup metadata.' ;;
    sync) description='Import committed agent HEAD and fast-forward the host task branch. A checked-out task branch also updates host files. Divergence stops the update and retains an incoming ref for manual recovery. Does not publish or merge into main.' ;;
    cleanup) description='Stop and remove the sandbox and task workspace. Refuse unpreserved files or Git objects unless --discard is provided. Retain upstream repositories, host branches, and incoming refs. Sandbox-local agent sessions and credentials are discarded.' ;;
    help)
      printf '%s\n' 'Usage: code-agent help [COMMAND]' '' 'Show general help or help for one lifecycle command.' 'Equivalent: code-agent COMMAND --help (or -h).'
      return
      ;;
    *) printf 'Unknown command: %s\n' "$command" >&2; return 2 ;;
  esac
  printf 'Usage: code-agent %s [TASK]' "$command"
  if [ "$command" = cleanup ]; then printf ' [--discard] [--dry-run]'; fi
  printf '\n\n%s\n\n' "$description"
  printf '%s\n' \
    'Task selection:' \
    '  Omit TASK to use the current host branch exactly.' \
    '  Explicit TASK names are normalized to lower snake case.'
  case "$command" in
    setup|start)
      printf '%s\n' '  Create a missing branch from the current one; select an existing branch.' '  On main, an omitted TASK prompts for a branch name.'
      ;;
    *) printf '%s\n' '  On main, provide TASK explicitly; no host branch is created or selected.' ;;
  esac
  case "$command" in
    setup|start|resume|sync)
      printf '\n%s\n' 'Safety: host tracked, staged, and untracked changes must be committed or stashed.'
      ;;
  esac
  if [ "$command" = sync ]; then
    printf '%s\n' 'The agent tree must be clean and on the task branch. Another worktree owning' 'the target branch blocks the update. LFS/submodule payloads are not transferred.'
  elif [ "$command" = cleanup ]; then
    printf '\n%s\n' 'Options:' '  --dry-run  Show removal targets without stopping or deleting anything.' '             Does not perform work-preservation checks.' '  --discard  Delete even unpreserved work. Irreversible; use deliberately.'
  fi
  case "$command" in
    start|resume|cleanup) printf '\n%s\n' 'Package managers use shared writable caches on new sandboxes; task cleanup retains them.' 'Concurrent VMs can corrupt lock-dependent caches. Stop all cache users before maintenance.' ;;
  esac
  printf '\nExamples:\n  ca %s\n  ca %s "Improve API"\n' "$command" "$command"
  printf '\n%s\n' 'Help: --help, -h, or help. Configuration: dotfiles.agentSandbox in Home Manager.'
}

if [ "$#" -eq 0 ]; then command_help; exit 0; fi
case "$1" in
  help|--help|-h)
    [ "$#" -le 2 ] || { command_help >&2; exit 2; }
    case "${2:-}" in
      --help|-h) command_help help ;;
      *) command_help "${2:-}" ;;
    esac
    exit 0
    ;;
esac
if [ "$#" -eq 1 ] && [ "$1" = --print-image ]; then printf '%s\n' "$image"; exit 0; fi
action="$1"
shift
case "$action" in
  setup|start|resume|stop|status|sync|cleanup) ;;
  *) printf 'Unknown command: %s\n' "$action" >&2; command_help >&2; exit 2 ;;
esac
for argument in "$@"; do
  case "$argument" in
    --help|-h|help)
      command_help "$action"
      exit 0
      ;;
  esac
done
task=''
explicit_task=false
if [ "$#" -gt 0 ] && [[ "$1" != --* ]]; then
  task="$1"
  explicit_task=true
  shift
fi
discard=false
dry_run=false
for option in "$@"; do
  [ "$action" = cleanup ] || { command_help "$action" >&2; exit 2; }
  case "$option" in
    --discard) discard=true ;;
    --dry-run) dry_run=true ;;
    *) command_help "$action" >&2; exit 2 ;;
  esac
done

repo_root="$(git rev-parse --show-toplevel)"
repo_root="$(realpath -e "$repo_root")"
host_branch="$(git -C "$repo_root" symbolic-ref --quiet HEAD)" || die 'host repository is in detached HEAD state'
host_branch="${host_branch#refs/heads/}"
require_host_clean() {
  local status
  status="$(git -C "$repo_root" status --porcelain --untracked-files=all)" || die 'cannot inspect host repository'
  [ -z "$status" ] || die 'commit or stash host changes before handover or sync'
}
case "$action" in setup|start|resume|sync) require_host_clean ;; esac
if [ "$explicit_task" = false ]; then
  task="$host_branch"
  if [ "$task" = main ]; then
    case "$action" in
      setup|start)
        printf 'On main. Enter a new task branch name: ' >&2
        IFS= read -r task || die 'no branch name provided; pass a task name explicitly'
        explicit_task=true
        ;;
      *) die 'on main; switch to the task branch or provide its name' ;;
    esac
  fi
fi
task_id="$(printf '%s' "$task" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/_/g; s/^_+//; s/_+$//')"
[ -n "$task_id" ] || die 'task name must contain at least one ASCII letter or number'
if [ "$explicit_task" = true ]; then branch="$task_id"; else branch="$task"; fi
[ "$branch" != main ] || die 'main cannot be used as a task branch; choose another name'
git check-ref-format --branch "$branch" >/dev/null || die 'invalid task branch'
task="$branch"
legacy_task_id="$task_id"
task_hash="$(printf '%s' "$branch" | sha256sum)"
task_hash="${task_hash:0:12}"
repo_hash="$(printf '%s' "$repo_root" | sha256sum)"
repo_hash="${repo_hash:0:12}"
# Readable names: <repo>-<path hash> identifies the checkout, so same-named
# repositories elsewhere stay separate. Task names are used as-is; long ones
# are truncated with a branch hash suffix. Normalized names never contain '-',
# so a suffixed name cannot equal an untruncated one. Other clashes (branches
# that normalize alike) are refused via the recorded task identity.
repo_name="$(basename -- "$repo_root" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9_-]+/_/g; s/^[_-]+//; s/[_-]+$//')"
repo_name="$(printf '%s' "${repo_name:0:24}" | sed -E 's/[_-]+$//')"
[ -n "$repo_name" ] || repo_name=repo
repo_key="$repo_name-${repo_hash:0:8}"
if [ "${#task_id}" -gt 40 ]; then task_id="${task_id:0:31}-${task_hash:0:8}"; fi
task_key="$repo_key-$task_id"
workspace_root="$(realpath -m "$workspace_directory")"
upstream_root="$(realpath -m "$upstream_directory")"
cache_root="$(realpath -m "$cache_directory")"
for private_root in "$repo_root" "$workspace_root" "$upstream_root"; do
  if [ "$cache_root" = / ] || [ "$private_root" = / ] || \
    [[ "$cache_root/" == "$private_root/"* ]] || [[ "$private_root/" == "$cache_root/"* ]]; then
    die 'package cache must not overlap the host repository, workspace, or upstream directories'
  fi
done
# One folder per task: the clone itself, mounted read-write as /workspace.
# Metadata and locks live in a hidden sibling directory that is never mounted,
# so the sandbox cannot tamper with them.
clone="$workspace_root/$task_key"
state_root="$workspace_root/.code-agent"
metadata="$state_root/$task_key.state"
task_lock="$state_root/$task_key.lock"
bare_repo="$upstream_root/$repo_key.git"
sandbox="$sandbox_prefix-$task_key"
legacy_task_dir="$workspace_root/code-agent/repo-$repo_hash/${legacy_task_id:0:40}-$task_hash"
[[ "$sandbox" =~ ^[a-zA-Z0-9][a-zA-Z0-9_-]*$ ]] || die 'invalid sandbox prefix'
[[ "$repo_root$workspace_root$upstream_root$cache_root" != *$'\n'* ]] || die 'paths containing newlines are unsupported'
[[ "$clone$bare_repo$cache_root" != *:* ]] || die 'volume paths containing colons are unsupported'
if [ -e "$legacy_task_dir" ] || [ -L "$legacy_task_dir" ]; then
  die "task uses the old workspace layout: $legacy_task_dir. Sync and clean it up with the previous code-agent version first; it is not migrated."
fi

check_paths() {
  local path
  for path in "$clone" "$state_root" "$metadata" "$task_lock" "$bare_repo"; do
    [ "$(realpath -m "$path")" = "$path" ] || die "refusing symlinked path: $path"
  done
  [ ! -e "$clone/.git" ] || [ ! -L "$clone/.git" ] || die 'refusing a symlinked .git directory'
}
check_paths

locked=false
upstream_locked=false
upstream_lock="${bare_repo%.git}.lock"
scratch=''
release() {
  [ -z "$scratch" ] || rm -rf -- "$scratch"
  if [ "$upstream_locked" = true ]; then rmdir -- "$upstream_lock"; fi
  if [ "$locked" = true ]; then rmdir -- "$task_lock"; fi
}
trap release EXIT
if [ "$action" = setup ] || [ "$action" = start ]; then
  mkdir -p "$state_root"
else
  [ -f "$metadata" ] || die "task is not set up: $clone"
fi
mkdir "$task_lock" 2>/dev/null || die "task is locked: $task_lock (remove only after confirming no command is running)"
locked=true
check_paths

if [ -e "$metadata" ]; then
  previous="$(git config --file "$metadata" --get task.repository || true)"
  [ "$previous" = "$repo_root" ] || die "workspace $clone belongs to another repository ($previous); move one of the checkouts or rename it"
  previous="$(git config --file "$metadata" --get task.name || true)"
  [ "$previous" = "$task" ] || die "workspace $clone is already used by branch '$previous'; choose a different task name"
  [ "$(git config --file "$metadata" --get task.sandbox)" = "$sandbox" ] || die 'sandbox prefix differs from task setup'
  [ "$(git config --file "$metadata" --get task.upstream)" = "$bare_repo" ] || die 'upstream root differs from task setup'
  previous_cache="$(git config --file "$metadata" --get task.cacheDirectory || true)"
  [ -z "$previous_cache" ] || [ "$previous_cache" = "$cache_root" ] || die 'cache directory differs from task setup; restore it before stopping or cleaning up'
fi

require_clone() {
  [ -d "$clone/.git" ] || die "workspace clone missing or incomplete: $clone"
  [ "$(git -C "$clone" rev-parse --show-toplevel)" = "$clone" ] || die 'workspace repository mismatch'
}
require_clean() {
  local status
  status="$(git -C "$clone" status --porcelain --untracked-files=all --ignored)" || die 'cannot inspect workspace; refusing to continue'
  [ -z "$status" ] || die 'workspace has modified, untracked, or ignored files; preserve them or use cleanup --discard'
}
sandbox_exists() {
  local names name
  names="$(msb ls -q)" || die 'cannot list microsandboxes; refusing to continue'
  while IFS= read -r name; do
    [ "$name" != "$sandbox" ] || return 0
  done <<< "$names"
  return 1
}
sandbox_status() {
  local inspection
  inspection="$(msb inspect "$sandbox" --format json)" || die 'cannot inspect sandbox'
  jq -er '.status | select(type == "string")' <<< "$inspection" || die 'invalid sandbox status'
}
stop_sandbox() {
  local status
  status="$(sandbox_status)"
  case "$status" in
    Paused) msb resume "$sandbox" ;;
    Running|Stopped|Created|Crashed) ;;
    *) die "sandbox is transitioning or has unknown status: $status; retry later" ;;
  esac
  msb stop "$sandbox"
  [ "$(sandbox_status)" = Stopped ] || die 'sandbox did not stop; refusing to continue'
}
warn_concurrent_caches() {
  local names name inspection status others=''
  if ! names="$(msb ls -q)"; then
    printf '%s\n' 'WARNING: Cannot check other VMs; shared cache concurrency risk is unknown.' >&2
    return
  fi
  while IFS= read -r name; do
    if [ -z "$name" ] || [ "$name" = "$sandbox" ]; then continue; fi
    if ! inspection="$(msb inspect "$name" --format json)" || \
      ! status="$(jq -er '.status | select(type == "string")' <<< "$inspection")"; then
      printf 'WARNING: Cannot inspect VM %s; shared cache concurrency risk is unknown.\n' "$name" >&2
      continue
    fi
    case "$status" in
      Running|Starting) others="${others}${others:+, }$name" ;;
    esac
  done <<< "$names"
  if [ -n "$others" ]; then
    printf 'WARNING: Other VMs are running: %s\n' "$others" >&2
    printf '%s\n' 'Shared package caches may be corrupted by concurrent writes: cross-VM file locks are not coordinated.' \
      'This warning does not block startup. Stop all cache users before clearing/rebuilding caches; affected task environments may also need rebuilding.' >&2
  fi
}
if [ "$action" != setup ] && [ "$action" != sync ]; then
  command -v msb >/dev/null 2>&1 || die 'microsandbox CLI (msb) is not on PATH'
fi

if [ "$action" = setup ] || [ "$action" = start ] || [ "$action" = sync ]; then
  # Serialize host branch selection, sync, and upstream publication across tasks.
  mkdir -p "$(dirname "$bare_repo")"
  [ "$(realpath -m "$upstream_lock")" = "$upstream_lock" ] || die 'refusing symlinked upstream lock'
  attempts=0
  until mkdir "$upstream_lock" 2>/dev/null; do
    attempts=$((attempts + 1))
    [ "$attempts" -lt 30 ] || die "upstream is locked: $upstream_lock (remove only after confirming no command is running)"
    sleep 1
  done
  upstream_locked=true
  check_paths
fi

if [ "$action" = setup ] || [ "$action" = start ]; then
  require_host_clean
  if git -C "$repo_root" show-ref --verify --quiet "refs/heads/$branch"; then
    git -C "$repo_root" switch --no-overwrite-ignore "$branch"
  else
    git -C "$repo_root" switch --no-overwrite-ignore -c "$branch"
  fi
  if [ ! -e "$metadata" ]; then
    source_branch="$branch"
    source_commit="$(git -C "$repo_root" rev-parse HEAD)"
    [ ! -e "$clone" ] || die 'unowned workspace exists; refusing to overwrite it'
    scratch="$(mktemp -d "$state_root/$task_key.init.XXXXXXXX")"
    git config --file "$scratch/state" task.repository "$repo_root"
    git config --file "$scratch/state" task.name "$task"
    git config --file "$scratch/state" task.sandbox "$sandbox"
    git config --file "$scratch/state" task.upstream "$bare_repo"
    git config --file "$scratch/state" task.sourceBranch "$source_branch"
    git config --file "$scratch/state" task.sourceCommit "$source_commit"
    mv -- "$scratch/state" "$metadata"
    rmdir -- "$scratch"
    scratch=''
  fi
  source_commit="$(git config --file "$metadata" --get task.sourceCommit)"
  mkdir -p "$(dirname "$bare_repo")"
  if [ ! -e "$bare_repo" ]; then git init --bare "$bare_repo" >/dev/null; fi
  [ "$(git -C "$bare_repo" rev-parse --is-bare-repository)" = true ] || die 'upstream is not a bare repository'
  # Immutable snapshot refs accept rebased source branches without force pushes.
  git -c push.gpgSign=false -C "$repo_root" push "$bare_repo" "$source_commit:refs/heads/snapshot-$source_commit"
  rmdir -- "$upstream_lock"
  upstream_locked=false
  if [ ! -e "$clone" ]; then
    git clone --no-hardlinks --branch "snapshot-$source_commit" "$bare_repo" "$clone"
  fi
  require_clone
  if [ "$(git config --file "$metadata" --get task.ready || true)" != true ]; then
    require_clean
    [ "$(git -C "$clone" rev-parse HEAD)" = "$source_commit" ] || die 'incomplete initialization contains work; refusing to reset it'
    if git -C "$clone" show-ref --verify --quiet "refs/heads/$branch"; then
      git -C "$clone" switch "$branch"
    else
      git -C "$clone" switch -c "$branch" "$source_commit"
    fi
    git -C "$clone" config remote.origin.url /mnt/upstream.git
    git -C "$clone" config remote.origin.pushurl /dev/null
    git -C "$clone" config user.name "$(git -C "$repo_root" config user.name || printf 'Code Agent')"
    git -C "$clone" config user.email "$(git -C "$repo_root" config user.email || printf 'code-agent@localhost')"
    git -C "$clone" config commit.gpgsign false
    git -C "$clone" config tag.gpgsign false
    git config --file "$metadata" task.ready true
  fi
fi

printf 'Task: %s\nBranch: %s\nSandbox: %s\nWorkspace: %s\nUpstream: %s\nCache: %s\n' "$task" "$branch" "$sandbox" "$clone" "$bare_repo" "$cache_root"
case "$action" in
  setup) ;;
  start|resume)
    require_clone
    [ "$(git config --file "$metadata" --get task.ready || true)" = true ] || die 'initialization incomplete; run code-agent setup first'
    if sandbox_exists; then
      case "$(sandbox_status)" in
        Running) ;;
        Paused) msb resume "$sandbox" ;;
        Created|Stopped|Crashed) msb start "$sandbox" ;;
        *) die 'sandbox is transitioning or has unknown status; retry later' ;;
      esac
    elif [ "$action" = resume ]; then
      die 'sandbox is absent; use code-agent start to recreate it'
    else
      mkdir -p "$cache_root"
      for cache in cargo/registry cargo/git gradle/caches gradle/wrapper maven/repository ivy; do
        [ "$(realpath -m "$cache_root/$cache")" = "$cache_root/$cache" ] || die 'refusing symlinked package cache directory'
        mkdir -p "$cache_root/$cache"
      done
      git config --file "$metadata" task.cacheDirectory "$cache_root"
      msb create --name "$sandbox" --cpus "$cpus" \
        --memory "$memory" \
        --volume "$bare_repo:/mnt/upstream.git:ro" \
        --volume "$clone:/workspace" \
        --volume "$cache_root:/cache" \
        --volume "$cache_root/cargo/registry:/root/.cargo/registry" \
        --volume "$cache_root/cargo/git:/root/.cargo/git" \
        --volume "$cache_root/gradle/caches:/root/.gradle/caches" \
        --volume "$cache_root/gradle/wrapper:/root/.gradle/wrapper" \
        --volume "$cache_root/maven/repository:/root/.m2/repository" \
        --volume "$cache_root/ivy:/root/.ivy2/cache" \
        --env PIP_CACHE_DIR=/cache/pip \
        --env UV_CACHE_DIR=/cache/uv --env UV_LINK_MODE=copy \
        --env npm_config_cache=/cache/npm --env YARN_CACHE_FOLDER=/cache/yarn \
        --env npm_config_store_dir=/cache/pnpm --env BUN_INSTALL_CACHE_DIR=/cache/bun \
        --env GOMODCACHE=/cache/go-mod --env GOCACHE=/cache/go-build \
        --env COURSIER_CACHE=/cache/coursier "$image"
    fi
    [ "$(sandbox_status)" = Running ] || die 'sandbox did not start; retry later'
    warn_concurrent_caches
    printf '%s\n' 'Entering the repository. Launch your agent manually; commit before sync. Exiting leaves the sandbox running.'
    rmdir -- "$task_lock"
    locked=false
    msb exec --tty "$sandbox" -- zsh -c 'cd /workspace && exec zsh'
    ;;
  stop)
    if sandbox_exists; then stop_sandbox; fi
    ;;
  status)
    msb ls
    ;;
  sync)
    require_clone
    require_clean
    [ "$(git -C "$clone" symbolic-ref --quiet HEAD)" = "refs/heads/$branch" ] || die 'workspace is not on the expected task branch'
    scratch="$(mktemp -d "${TMPDIR:-/tmp}/code-agent.XXXXXXXX")"
    git -C "$clone" bundle create "$scratch/result.bundle" HEAD
    git -C "$repo_root" bundle verify "$scratch/result.bundle" >/dev/null
    incoming_commit="$(git -C "$clone" rev-parse HEAD)"
    incoming_ref="refs/code-agent/incoming/$task_hash/$incoming_commit"
    git -C "$repo_root" fetch "$scratch/result.bundle" "HEAD:$incoming_ref"
    if git -C "$repo_root" show-ref --verify --quiet "refs/heads/$branch"; then
      git -C "$repo_root" merge-base --is-ancestor "refs/heads/$branch" "$incoming_ref" || die "host branch cannot fast-forward; agent work retained at $incoming_ref. Merge or rebase manually"
    fi
    require_host_clean
    if [ "$(git -C "$repo_root" symbolic-ref --quiet HEAD)" = "refs/heads/$branch" ]; then
      git -C "$repo_root" merge --ff-only --no-squash --no-overwrite-ignore "$incoming_ref"
    else
      # Git refuses updates to a branch checked out in another worktree.
      git -C "$repo_root" fetch "$scratch/result.bundle" "HEAD:refs/heads/$branch"
    fi
    [ "$(git -C "$repo_root" rev-parse "refs/heads/$branch")" = "$incoming_commit" ] || die 'host branch did not reach the agent commit; inspect the incoming ref'
    printf 'Fast-forwarded host branch %s; review before merging into main or publishing.\n' "$branch"
    ;;
  cleanup)
    if [ "$dry_run" = true ]; then
      sandbox_exists || true
      printf 'Would remove sandbox %s and task workspace %s. No work-preservation checks performed.\n' "$sandbox" "$clone"
      exit 0
    fi
    if sandbox_exists; then stop_sandbox; fi
    check_paths
    if [ "$discard" = false ]; then
      require_clone
      # The clone is the entire writable mount, so its status covers every file.
      require_clean
      scratch="$(mktemp -d "${TMPDIR:-/tmp}/code-agent.XXXXXXXX")"
      # Include stash, reflogs, and annotated tags, not just the current branch.
      git -C "$clone" rev-list --objects --all --reflog HEAD | cut -d ' ' -f 1 | sort -u > "$scratch/workspace-objects"
      git -C "$repo_root" rev-list --objects --all | cut -d ' ' -f 1 | sort -u > "$scratch/host-objects"
      comm -23 "$scratch/workspace-objects" "$scratch/host-objects" > "$scratch/missing"
      [ ! -s "$scratch/missing" ] || die 'workspace commits or Git objects are not preserved in host refs; preserve them or use cleanup --discard'
    fi
    if sandbox_exists; then msb rm --force "$sandbox"; fi
    check_paths
    rm -rf -- "$clone"
    rm -f -- "$metadata"
    rmdir -- "$task_lock"
    locked=false
    printf '%s\n' 'Removed task workspace and sandbox; retained upstream and host branches.'
    ;;
esac
