#!/usr/bin/env bash

set -euo pipefail

usage() {
  printf 'usage: %s TASK-NAME\n' "$0" >&2
  exit 2
}

normalize_task() {
  local normalized
  normalized="$(printf '%s' "$1" \
    | tr '[:upper:]' '[:lower:]' \
    | sed -E 's/[^a-z0-9]+/_/g; s/^_+//; s/_+$//; s/_+/_/g')"
  [ -n "$normalized" ] || {
    echo "task name must contain at least one letter or number" >&2
    exit 2
  }
  printf '%s\n' "$normalized"
}

[ "$#" -eq 1 ] || usage

task_id="$(normalize_task "$1")"
repo_root="$(git rev-parse --show-toplevel)"
repo_name="$(basename "$repo_root")"
active_branch="$(git -C "$repo_root" symbolic-ref --quiet --short HEAD)" || {
  echo "the active repository is in detached HEAD state" >&2
  exit 1
}

upstream_root="${HANDOVER_UPSTREAM_DIR:-$HOME/development/agent/upstream-ro}"
workspace_root="${HANDOVER_WORKSPACES_DIR:-$HOME/development/agent/workspaces}"
bare_repo="$upstream_root/$repo_name.git"
task_workspace="$workspace_root/$task_id"

mkdir -p "$upstream_root"
if [ -e "$bare_repo" ]; then
  if [ ! -d "$bare_repo" ]; then
    echo "upstream path exists but is not a bare Git repository: $bare_repo" >&2
    exit 1
  elif [ "$(git -C "$bare_repo" rev-parse --is-bare-repository 2>/dev/null)" != "true" ]; then
    echo "upstream path exists but is not a bare Git repository: $bare_repo" >&2
    exit 1
  fi
else
  git init --bare "$bare_repo" >/dev/null
fi

git -C "$bare_repo" symbolic-ref HEAD refs/heads/main

git -C "$repo_root" show-ref --verify --quiet refs/heads/main || {
  echo "the active repository does not have a local main branch" >&2
  exit 1
}

git -C "$repo_root" push "$bare_repo" \
  "HEAD:refs/heads/$active_branch" \
  "refs/heads/main:refs/heads/main"

mkdir -p "$task_workspace"

cat <<EOF
Task:       $task_id
Repository: $repo_name
Upstream:   $bare_repo
Workspace:  $task_workspace

Clone the upstream repository into the workspace before starting the agent:
  git clone --no-hardlinks "$bare_repo" "$task_workspace/$repo_name"
EOF
