# The infra-agent broker image: an MCP gateway in front of read-only MCP servers.
# It holds no configuration or credentials of its own. infra-agent mounts the
# per-environment configuration (generated by modules/infra-agent) at
# /etc/infra-broker and the credd token plus incident tokens at /run/infra, and
# routes vsock port 9100 to infra-credd on the host.
#
# Like the agent image, this is a script that streams the image tarball.
{ inputs, system }:
let
  pkgs = import inputs.nixpkgs { inherit system; };
  inherit (pkgs) lib;

  broker = pkgs.callPackage ../../packages/infra-broker { };
  dbhub = pkgs.callPackage ../../packages/dbhub { };
  kubernetes-mcp-server = pkgs.callPackage ../../packages/kubernetes-mcp-server { };
  # Unmodified upstream release (see the package for why); it authenticates
  # only through the managed-identity endpoint served by infra-credd.
  azure-mcp = pkgs.callPackage ../../packages/azure-mcp { };

  creddPort = "9100";
  entrypoint = pkgs.writeShellApplication {
    name = "infra-broker";
    runtimeInputs = [ pkgs.coreutils pkgs.socat broker ];
    text = ''
      token_file=/run/infra/credd-token
      config=/etc/infra-broker/gateway.json
      [ -s "$token_file" ] || { echo "infra-broker: $token_file is missing (start the broker with infra-agent)" >&2; exit 1; }
      [ -f "$config" ] || { echo "infra-broker: $config is missing (start the broker with infra-agent)" >&2; exit 1; }
      mkdir -p /tmp/home /tmp/logs /tmp/work

      # infra-credd on the host, reached over vsock. HTTP clients (AWS and Azure
      # SDKs) only accept credential endpoints on loopback, hence the bridge.
      socat TCP-LISTEN:${creddPort},bind=127.0.0.1,fork,reuseaddr VSOCK-CONNECT:2:${creddPort} &

      IDENTITY_HEADER="$(cat "$token_file")"
      export IDENTITY_HEADER
      # microsandbox intercepts HTTPS and adds its CA to the system bundle.
      # boto3 and requests ship their own bundles unless told otherwise.
      ca_bundle="''${SSL_CERT_FILE:-/etc/ssl/certs/ca-certificates.crt}"
      if [ -f "$ca_bundle" ]; then
        export AWS_CA_BUNDLE="''${AWS_CA_BUNDLE:-$ca_bundle}"
        export REQUESTS_CA_BUNDLE="''${REQUESTS_CA_BUNDLE:-$ca_bundle}"
        export SSL_CERT_FILE="$ca_bundle"
      else
        echo "infra-broker: no CA bundle at $ca_bundle; HTTPS through microsandbox interception will fail" >&2
      fi
      if [ -z "''${NODE_EXTRA_CA_CERTS:-}" ] && [ -r /.msb/tls/ca.pem ]; then export NODE_EXTRA_CA_CERTS=/.msb/tls/ca.pem; fi
      export INFRA_CREDD_URL=http://127.0.0.1:${creddPort}
      export INFRA_CREDD_TOKEN_FILE="$token_file"
      export AWS_CONTAINER_AUTHORIZATION_TOKEN_FILE="$token_file"
      export IDENTITY_ENDPOINT=http://127.0.0.1:${creddPort}/msi/token
      exec infra-broker-gateway --config "$config"
    '';
  };

  contents = pkgs.buildEnv {
    name = "infra-broker-image-contents";
    paths = [
      pkgs.bashInteractive pkgs.coreutils pkgs.gnugrep pkgs.findutils pkgs.less pkgs.procps
      pkgs.socat pkgs.curl
      broker dbhub kubernetes-mcp-server azure-mcp entrypoint
    ];
    pathsToLink = [ "/bin" "/share" ];
  };
in
pkgs.dockerTools.streamLayeredImage {
  name = "dotfiles-infra-broker";
  tag = "latest";
  contents = [ contents ];
  extraCommands = ''
    mkdir -p etc/infra-broker run/infra tmp
    chmod 1777 tmp
    # The Azure MCP release binary expects the standard loader path.
    mkdir -p "$(dirname .${azure-mcp.fhsInterpreter})"
    ln -s ${azure-mcp.interpreterTarget} .${azure-mcp.fhsInterpreter}
    printf 'root:x:0:0:root:/root:/bin/bash\nbroker:x:1000:1000:infra broker:/tmp/home:/bin/bash\n' > etc/passwd
    printf 'root:x:0:\nbroker:x:1000:\n' > etc/group
  '';
  config = {
    Cmd = [ "/bin/infra-broker" ];
    Env = [
      "HOME=/tmp/home"
      "PATH=/bin"
      "FASTMCP_CHECK_FOR_UPDATES=off"
      "FASTMCP_SHOW_SERVER_BANNER=false"
      "PYTHONUNBUFFERED=1"
      "AWS_EC2_METADATA_DISABLED=true"
      "AZURE_MCP_COLLECT_TELEMETRY=false"
      "DOTNET_CLI_TELEMETRY_OPTOUT=1"
    ];
    User = "1000:1000";
    WorkingDir = "/tmp";
  };
}
